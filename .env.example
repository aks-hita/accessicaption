# AccessiCaption Environment Variables
# Copy this file to `.env` and fill in your values.
# Never commit `.env` to version control.

# ---------------------------------------------------------------------------
# Model configuration
# ---------------------------------------------------------------------------

# Local path to the merged/saved model weights.
# Used by the FastAPI server when running locally.
MODEL_PATH=./outputs/accessicaption-v1/merged

# HuggingFace Hub model ID.
# Used by the Gradio Space demo and during evaluation.
HF_MODEL_ID=YOUR_HF_USERNAME/accessicaption-llava-qlora

# ---------------------------------------------------------------------------
# API authentication
# ---------------------------------------------------------------------------

# Comma-separated list of valid API bearer tokens.
# Leave empty to disable authentication (development only).
ACCESSICAPTION_API_KEYS=key_test_abc123,key_prod_xyz789

# ---------------------------------------------------------------------------
# HuggingFace & experiment tracking
# ---------------------------------------------------------------------------

# HuggingFace Hub token (required to push/pull private models and datasets).
HF_TOKEN=your_huggingface_token_here

# Weights & Biases API key (optional — used for training run tracking).
WANDB_API_KEY=your_wandb_key_here

# ---------------------------------------------------------------------------
# Runtime options
# ---------------------------------------------------------------------------

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Device override for the Gradio Space: auto | cpu | cuda | cuda:0
DEVICE=auto

# Load the model in 4-bit (requires bitsandbytes): true | false
LOAD_IN_4BIT=true

# FastAPI server host and port (used by uvicorn)
HOST=0.0.0.0
PORT=8000
